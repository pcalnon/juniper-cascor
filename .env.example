########################################################################################################################################################################################################################
# juniper-cascor Environment Variables
# ------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then encrypt with SOPS:
#   sops -e .env > .env.enc
########################################################################################################################################################################################################################

# === Application Settings (JUNIPER_CASCOR_ prefix) ===
# All settings below are loaded by pydantic-settings with the JUNIPER_CASCOR_ prefix.
# See src/api/settings.py for the full Settings class definition.

# Server
JUNIPER_CASCOR_HOST=127.0.0.1
JUNIPER_CASCOR_PORT=8200
JUNIPER_CASCOR_LOG_LEVEL=INFO
JUNIPER_CASCOR_CORS_ORIGINS=["*"]

# SEC-F22 / D2 — startup bind-guard attestation (two-flag scheme). Both default
# false (fail-closed). When JUNIPER_CASCOR_HOST is a NON-loopback interface
# (e.g. 0.0.0.0), the service REFUSES to start unless AT LEAST ONE of the two
# attestations below is true. The control/worker WebSocket surface has no
# app-layer auth of its own; loopback binds always start. Set the flag that
# matches the control actually protecting the port:
#   - JUNIPER_CASCOR_LOOPBACK_PUBLISH_ATTESTED: the port is reachable ONLY via a
#     loopback-only host publish (the container default: 127.0.0.1:8200:8200 in
#     compose; verifiable by the juniper-deploy preflight).
#   - JUNIPER_CASCOR_AUTH_PROXY_ATTESTED: a fronting authenticating reverse proxy
#     terminates access before the port (Phase-4; attestation only).
# In the container the bind is 0.0.0.0 behind a loopback host-publish, so a
# deploy roll-out sets LOOPBACK_PUBLISH_ATTESTED=true (owner-gated). See
# notes/JUNIPER_CASCOR_CONTROL_SURFACE_AUTH_AND_NAT_SECURITY_NOTE_2026-07-04.md.
# JUNIPER_CASCOR_LOOPBACK_PUBLISH_ATTESTED=false
# JUNIPER_CASCOR_AUTH_PROXY_ATTESTED=false

# WebSocket
JUNIPER_CASCOR_WS_MAX_CONNECTIONS=50
JUNIPER_CASCOR_WS_HEARTBEAT_INTERVAL_SEC=30
# SEC-F19 / D4 — WebSocket connection caps (DoS-dampening, NOT authentication).
# Global: stack-absolute ceiling across ALL WS endpoints (training+control+worker
# combined) — the availability backstop that survives Docker NAT. Per-identity:
# per authenticated principal (API-key token), enforced on /ws/control. Per-IP is
# inert behind NAT (every client presents as the bridge gateway). Must exceed the
# expected legitimate total (clients + control + the worker fleet).
# JUNIPER_CASCOR_WS_MAX_CONNECTIONS_GLOBAL=200
# JUNIPER_CASCOR_WS_MAX_CONNECTIONS_PER_IDENTITY=5
# JUNIPER_CASCOR_WS_MAX_CONNECTIONS_PER_IP=5

# Security (leave unset to disable authentication)
# JUNIPER_CASCOR_API_KEYS=["your-api-key-here"]
# Docker Compose / Swarm: prefer a mounted secret via the companion _FILE var.
# When JUNIPER_CASCOR_API_KEYS_FILE points at an existing file, get_secret()
# returns that file's stripped contents — including "" for empty/whitespace-only
# placeholder files — and does NOT fall back to the plain env var. An empty
# secret file therefore yields open auth (HO-2 class) unless REQUIRE_AUTH is on.
# JUNIPER_CASCOR_API_KEYS_FILE=/run/secrets/juniper_cascor_api_keys
#
# SEC-F01 — boot-time auth-posture self-check (juniper-service-core).
# Default false: missing/blank keys only WARN ("running OPEN") and the service
# starts (bare/dev). Set true wherever secrets are provisioned (composed
# juniper-deploy stack) so a missing/blank key is a boot FAILURE
# (AuthPostureError). Bypass (logged loudly): JUNIPER_SKIP_AUTH_POSTURE_CHECK=1.
# JUNIPER_CASCOR_REQUIRE_AUTH=false
# JUNIPER_CASCOR_RATE_LIMIT_ENABLED=false
# JUNIPER_CASCOR_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Observability
JUNIPER_CASCOR_LOG_FORMAT=text
# JUNIPER_CASCOR_SENTRY_DSN=
# JUNIPER_CASCOR_METRICS_ENABLED=false

# Auto-start training (used by demo profile)
# JUNIPER_CASCOR_AUTO_START=false
# JUNIPER_CASCOR_AUTO_DATASET=spiral
# JUNIPER_CASCOR_AUTO_DATASET_PARAMS={}
# JUNIPER_CASCOR_AUTO_NETWORK={}
# JUNIPER_CASCOR_AUTO_TRAIN_EPOCHS=200

# === External API Tokens ===
HF_TOKEN=
ALPHA_VANTAGE_TOKEN=
SCOUT_TOKEN=
EXA_API_KEY=
KAGGLE_API_TOKEN=
SENTRY_SDK_DSN=

# API Key for LLM Providers
ANTHROPIC_API_KEY=

# === PyPI API access tokens ===
# username: __token__, password: the token value (including pypi- prefix)
JUNIPER_ML_TEST_USERNAME=
JUNIPER_ML_TEST_PYPI=
JUNIPER_ML_USERNAME=
JUNIPER_ML_PYPI=
TWINE_USERNAME=
TWINE_PASSWORD=
TEST_TWINE_USERNAME=
TEST_TWINE_PASSWORD=
